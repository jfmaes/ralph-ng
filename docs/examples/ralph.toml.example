[ralph]
branch_prefix = "ralph/"
auto_push = false
max_retries_per_task = 5
max_ratchet_checks_per_task = 10
# Use only if your default executor is a less capable model.
# auto_escalate = 4
auto_escalate_model = "opus"

[models]
executor = "opus"
cli = "claude"

[roles.executor]
provider = "claude"
model = "opus"
cli_path = "claude"

[roles.reviewer]
provider = "codex"
model = "gpt-5.3-codex"
cli_path = "codex"

[timeouts]
executor_call_seconds = 600
verification_command_seconds = 120
reviewer_call_seconds = 300

[git]
protected_branches = ["main", "master"]
force_push = false

[self_healing]
enabled = true
diagnosis_provider = "claude"
diagnosis_model = "opus"
diagnosis_cli_path = "claude"
max_diagnosis_per_task = 1
max_auto_fix_actions_per_task = 2
diagnosis_timeout_seconds = 120
